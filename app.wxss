page {
  background: #f5f5f5;
  color: #333;
  font-family: 'YouYuan', 'PingFang SC', 'Comic Sans MS', sans-serif;
}

.btn-primary {
  background: linear-gradient(135deg, #ff8db2, #ff7a95);
  color: #fff;
  border: none;
}

.btn-secondary {
  background: #fff;
  border: 1px solid #ffd0dc;
  color: #ff5e87;
}
