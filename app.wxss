page {
  background: #fff5f8;
  color: #333;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.06);
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.btn-primary {
  background: linear-gradient(135deg, #ff8db2, #ff7a95);
  color: #fff;
  border: none;
}

.btn-secondary {
  background: #fff;
  border: 1px solid #ffd0dc;
  color: #ff5e87;
}
