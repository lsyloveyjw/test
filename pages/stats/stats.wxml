<view class="page">
  <view class="topbar"><view class="title">成长分析</view></view>

  <view class="content">
    <view class="card">
      <view class="periods">
        <view wx:for="{{periods}}" wx:key="*this" class="pill {{activePeriod===item?'pill-active':''}}" data-p="{{item}}" bindtap="switchPeriod">{{item}}</view>
      </view>

      <view class="line">{{aName}}：{{activePeriod}} 科技树 +{{aTech}} 分 · 情感树 +{{aEmotion}} 分</view>
      <view class="line">{{bName}}：{{activePeriod}} 科技树 +{{bTech}} 分 · 情感树 +{{bEmotion}} 分</view>

      <view class="compare">进步对比（{{activePeriod}}）</view>
      <view class="small">科技树对比线</view>
      <view class="bar-bg"><view class="bar a" style="width: {{(aTech/(aTech+bTech||1))*100}}%"></view></view>
      <view class="small">情感树对比线</view>
      <view class="bar-bg"><view class="bar b" style="width: {{(aEmotion/(aEmotion+bEmotion||1))*100}}%"></view></view>
    </view>

    <view class="card">
      <view class="panel-title">💰 我的成长面板</view>
      <view>用户：{{aName}}</view>
      <view class="line2">科技树：{{aTech}} 分</view>
      <view class="line2">情感树：{{aEmotion}} 分</view>
      <view class="line2">合计：{{aTech + aEmotion}} 分</view>
    </view>
  </view>
</view>
