<view class="container">
  <view class="card">
    <view class="k">关系温度</view>
    <view class="big">{{relationScore}} 分</view>
    <view class="tip">在一起第 {{loveDays}} 天 · 下个纪念日 {{countdownDays}} 天后</view>
  </view>

  <view class="grid">
    <view class="card"><view class="k">成长记录</view><view class="v">{{growthTotal}}</view></view>
    <view class="card"><view class="k">修复记录</view><view class="v">{{repairTotal}}</view></view>
    <view class="card full"><view class="k">连续互动</view><view class="v">{{streak}} 天</view></view>
  </view>

  <view class="card">
    <view class="k">类型分布</view>
    <view wx:for="{{typeSummary}}" wx:key="type" class="row">
      <text>{{item.type}}</text>
      <text>{{item.count}} 次</text>
    </view>
  </view>

  <view class="card">
    <view class="k">最近14天趋势</view>
    <view wx:if="{{recentTrend.length===0}}" class="empty">暂无数据</view>
    <view wx:for="{{recentTrend}}" wx:key="date" class="row">
      <text>{{item.date}}</text>
      <text>{{item.count}} 次</text>
    </view>
  </view>
</view>
