page { background:#f5f5f5; font-family:'YouYuan','PingFang SC','Comic Sans MS',sans-serif; }
.topbar { background:#f79ab2; padding:28rpx 24rpx; padding-top:52rpx; }
.title { text-align:center; font-size:48rpx; font-weight:700; }
.content { padding:20rpx; }
.card { background:#fff; border-radius:24rpx; padding:20rpx; margin-bottom:16rpx; }
.section-title { font-size:34rpx; font-weight:700; margin-bottom:12rpx; }
.user-panel { display:flex; align-items:center; gap:14rpx; padding:12rpx 0; border-bottom:1px solid #f1f1f1; }
.user-panel:last-child { border-bottom:none; }
.avatar { width:96rpx; height:96rpx; border-radius:50%; background:#eee; }
.name { font-size:32rpx; font-weight:700; }
.meta { color:#666; margin-top:4rpx; }
