.container { padding:24rpx; background:#fff7fb; }
.card { background:#fff; border-radius:20rpx; padding:20rpx; margin-bottom:16rpx; }
.k { color:#777; }
.big { font-size:64rpx; color:#ff4f7b; font-weight:700; margin-top:8rpx; }
.tip { color:#888; margin-top:8rpx; }
.grid { display:grid; grid-template-columns:1fr 1fr; gap:12rpx; }
.full { grid-column: 1 / span 2; }
.v { font-size:42rpx; color:#ff5f8a; font-weight:700; margin-top:8rpx; }
.row { display:flex; justify-content:space-between; padding:10rpx 0; border-bottom:1px dashed #ffd7e1; }
.empty { color:#999; text-align:center; padding:16rpx 0; }
