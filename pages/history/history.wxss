.container { padding:24rpx; background:#fff7fb; }
.card { background:#fff; border-radius:20rpx; padding:20rpx; margin-bottom:16rpx; }
.tabs { display:flex; gap:10rpx; }
.tab { flex:1; text-align:center; padding:12rpx 0; border-radius:12rpx; background:#fff1f6; color:#ff628c; }
.tab-active { background:#ff6f95; color:#fff; }
.time { color:#888; font-size:24rpx; margin-top:8rpx; }
