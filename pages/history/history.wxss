.container { padding: 24rpx; }
.tag-scroll { white-space: nowrap; margin-bottom: 18rpx; }
.f-tag { display:inline-block; margin-right:10rpx; padding:8rpx 16rpx; border-radius:999rpx; background:#fff1f5; color:#ff628c; }
.f-tag-active { background:#ff6f95; color:#fff; }
.item { margin-bottom: 16rpx; }
.row { display:flex; justify-content:space-between; }
.time { color:#888; font-size:24rpx; }
.note { margin: 10rpx 0; color: #444; }
.mini-btn { width: 130rpx; margin: 0; background:#fff; border:1px solid #ffc7d6; color:#ff5e87; font-size:24rpx; }
