page { background:#f5f5f5; font-family:'YouYuan','PingFang SC','Comic Sans MS',sans-serif; }
.topbar { background:#f79ab2; padding:28rpx 24rpx; padding-top:52rpx; }
.title { text-align:center; font-size:48rpx; font-weight:700; }
.content { padding:20rpx; }
.card,.reward-card { background:#fff; border-radius:24rpx; padding:20rpx; margin-bottom:16rpx; }
.section-title { font-size:34rpx; font-weight:700; margin-bottom:10rpx; }
.row { display:flex; gap:10rpx; }
.input { background:#fafafa; border:1px solid #eee; border-radius:12rpx; padding:12rpx 14rpx; margin-bottom:10rpx; }
.inline { flex:1; }
.points { width:140rpx; }
.name { font-size:32rpx; font-weight:700; color:#222; }
.meta { color:#666; margin-top:8rpx; }
.actions { display:flex; gap:10rpx; margin-top:10rpx; }
.btn { background:#f48ea8; color:#fff; border:none; }
.btn-mini { background:#111; color:#fff; }
.secondary { background:#fff; color:#555; border:1px solid #ddd; }
.danger { background:#fff0f0; color:#da3f3f; border:1px solid #f4bcbc; }
