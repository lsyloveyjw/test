<view class="container">
  <view class="tabs card">
    <view class="tab {{tab==='growth'?'tab-active':''}}" data-tab="growth" bindtap="onTabTap">成长时间轴</view>
    <view class="tab {{tab==='repair'?'tab-active':''}}" data-tab="repair" bindtap="onTabTap">修复时间轴</view>
  </view>

  <view class="card" wx:if="{{tab==='growth' && growthRecords.length===0}}">暂无成长记录</view>
  <view class="card" wx:if="{{tab==='repair' && repairRecords.length===0}}">暂无修复记录</view>

  <view class="card" wx:if="{{tab==='growth'}}" wx:for="{{growthRecords}}" wx:key="id">
    <view>{{item.user==='me'?'我':'TA'}} · {{item.tag}}</view>
    <view>{{item.note || '无备注'}}</view>
    <view class="time">{{item.date}} {{item.time}}</view>
  </view>

  <view class="card" wx:if="{{tab==='repair'}}" wx:for="{{repairRecords}}" wx:key="id">
    <view>🫶 {{item.user==='me'?'我':'TA'}} 的修复记录</view>
    <view>{{item.note}}</view>
    <view class="time">{{item.date}} {{item.time}}</view>
  </view>
</view>
