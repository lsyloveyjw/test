<view class="page">
  <view class="topbar"><view class="title">成长商城</view></view>
  <view class="content">
    <input class="search" placeholder="搜索商品" bindinput="onSearch" />

    <view class="group-title">货架 <text class="badge">{{onlineItems.length}}</text></view>
    <view class="list-card">
      <view class="item" wx:for="{{onlineItems}}" wx:key="id">
        <view>
          <view class="name">{{item.title}}</view>
          <view class="meta">💰 {{item.points}} 积分</view>
          <view class="date">📅 {{item.date}} 创建</view>
        </view>
        <view class="icon">{{item.icon}}</view>
      </view>
    </view>

    <view class="group-title">已下架 <text class="badge">{{offlineItems.length}}</text></view>
    <view class="list-card">
      <view class="item" wx:for="{{offlineItems}}" wx:key="id">
        <view>
          <view class="name">{{item.title}}</view>
          <view class="meta">💰 {{item.points}} 积分</view>
          <view class="date">📅 {{item.date}} 创建</view>
        </view>
        <view class="icon">{{item.icon}}</view>
      </view>
    </view>
  </view>
</view>
