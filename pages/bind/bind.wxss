page { background:#f5f5f5; font-family:'YouYuan','PingFang SC',sans-serif; }
.page { padding:24rpx; }
.top { background:#f79ab2; margin:-24rpx -24rpx 20rpx; padding:56rpx 24rpx 24rpx; text-align:center; font-size:46rpx; font-weight:700; }
.card { background:#fff; border-radius:24rpx; padding:24rpx; margin-bottom:16rpx; }
.avatar { width:120rpx; height:120rpx; border-radius:50%; margin:0 auto 12rpx; display:block; }
.name { text-align:center; font-size:34rpx; font-weight:700; }
.tip { text-align:center; color:#888; margin-top:8rpx; }
.input { background:#fafafa; border:1px solid #eee; border-radius:12rpx; padding:12rpx 14rpx; margin-top:12rpx; }
.btn { background:#f48ea8; color:#fff; border:none; }
.second { margin-top:12rpx; background:#fff; color:#555; border:1px solid #ddd; }
