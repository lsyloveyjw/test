page { background:#f5f5f5; }
.login-page { min-height:100vh; position:relative; }
.bg { width:100%; height:100vh; }
.mask-card { position:absolute; left:40rpx; right:40rpx; bottom:120rpx; background:#fff; border-radius:28rpx; padding:34rpx; box-shadow:0 10rpx 30rpx rgba(0,0,0,.15); }
.title { font-size:52rpx; font-weight:700; margin-bottom:14rpx; }
.sub { color:#777; margin-bottom:20rpx; }
.user-box { display:flex; align-items:center; gap:12rpx; background:#f7f7f7; border-radius:12rpx; padding:10rpx 12rpx; margin-bottom:16rpx; }
.avatar { width:56rpx; height:56rpx; border-radius:50%; }
.btn-login { background:#111; color:#fff; border:none; border-radius:14rpx; }
.btn-ghost { margin-top:10rpx; background:#f4f4f4; color:#333; border:none; border-radius:14rpx; }
.agreement { margin-top:20rpx; color:#999; font-size:24rpx; text-align:center; }
