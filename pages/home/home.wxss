.container { padding: 24rpx; }
.header { background: linear-gradient(135deg,#ffe4ee,#fff3d9); }
.title { font-size: 34rpx; font-weight: 700; color: #ff4f7b; }
.subtitle { margin-top: 10rpx; color: #666; }
.section-title { margin: 14rpx 0; font-weight: 600; }
.tags,.moods { display:flex; flex-wrap:wrap; gap: 12rpx; margin-bottom: 14rpx; }
.tag,.mood { padding: 8rpx 18rpx; border-radius: 999rpx; background:#fff3f7; color:#ff658f; }
.tag-active,.mood-active { background:#ff6f95; color:#fff; }
.note { width:100%; min-height: 170rpx; background:#fff7fa; border-radius: 12rpx; padding: 12rpx; box-sizing:border-box; margin-bottom: 18rpx; }
.time { margin-top: 8rpx; color: #888; font-size: 24rpx; }
