page { background: #f3f3f3; }
.page { min-height: 100vh; }
.topbar { background:#f79ab2; padding: 24rpx; padding-top: 48rpx; }
.title { text-align:center; font-size: 46rpx; font-weight:700; color:#111; }
.content { padding: 20rpx; }
.card { background:#fff; border-radius: 24rpx; padding: 20rpx; margin-bottom: 20rpx; }
.section-title { color:#666; font-size: 42rpx; margin-bottom: 12rpx; }
.chips { display:flex; gap:12rpx; }
.chip { padding:8rpx 24rpx; border-radius:999rpx; background:#fff; border:1px solid #ddd; }
.active { background:#111; color:#fff; border-color:#111; }
.hint { color:#888; margin-top: 12rpx; }
.input { background:#f8f8f8; border-radius:12rpx; padding:12rpx; margin-bottom:10rpx; }
.summary { color:#555; margin: 6rpx 0 12rpx; }
.btn { background:#f48ea8; color:#fff; border:none; }
.section-head { font-size: 42rpx; margin: 16rpx 0; color:#555; }
.badge { background:#ff5b6a; color:#fff; border-radius:999rpx; padding:0 12rpx; font-size:24rpx; }
.task-card { background:#fff; border-radius:24rpx; padding:20rpx; margin-bottom:16rpx; }
.task-title { font-size:42rpx; font-weight:700; color:#222; }
.task-desc { color:#666; margin: 8rpx 0 12rpx; }
.task-foot { display:flex; justify-content:space-between; align-items:center; color:#c64f7a; }
.btn-mini { background:#111; color:#fff; }
