page { background:#f3f3f3; font-family:'YouYuan','PingFang SC','Comic Sans MS',sans-serif; }
.topbar { background:#f79ab2; padding:28rpx 24rpx; padding-top:52rpx; }
.title { text-align:center; font-size:48rpx; font-weight:700; }
.content { padding:20rpx; }
.operator { color:#666; text-align:center; margin-bottom:12rpx; }
.card,.group-card { background:#fff; border-radius:24rpx; padding:20rpx; margin-bottom:16rpx; }
.creation { background:#f7f4ff; }
.section-title,.group-title { font-size:40rpx; color:#555; margin:8rpx 0 12rpx; }
.badge { background:#ff5b6a; color:#fff; border-radius:999rpx; padding:0 12rpx; font-size:24rpx; }
.chips { display:flex; gap:10rpx; margin-bottom:12rpx; }
.chip { padding:8rpx 18rpx; border-radius:999rpx; border:1px solid #ddd; background:#fff; }
.active { background:#111; color:#fff; border-color:#111; }
.input { background:#fafafa; border:1px solid #eee; border-radius:12rpx; padding:12rpx 14rpx; margin-bottom:10rpx; }
.btn { background:#f48ea8; color:#fff; border:none; }
.task-row { display:flex; justify-content:space-between; gap:14rpx; padding:12rpx 0; border-bottom:1px solid #f1f1f1; }
.task-row:last-child { border-bottom:none; }
.task-main { flex:1; }
.task-title { font-size:38rpx; font-weight:700; }
.task-desc { color:#8c8c8c; margin-top:4rpx; }
.task-foot { color:#c64f7a; margin-top:6rpx; }
.check-col { display:flex; flex-direction:column; gap:8rpx; }
.mini { background:#111; color:#fff; min-width:68rpx; }
.second { background:#fff; color:#555; border:1px solid #ddd; }
.danger { background:#fff0f0; color:#da3f3f; border:1px solid #f4bcbc; }
