<view class="page">
  <view class="topbar">
    <view class="title">成长打卡中心</view>
  </view>

  <view class="content">
    <view class="card">
      <view class="section-title">成长者筛选</view>
      <view class="chips">
        <view wx:for="{{ownerList}}" wx:key="*this" class="chip {{owner===item?'active':''}}" data-owner="{{item}}" bindtap="switchOwner">{{item}}</view>
      </view>
      <view class="hint">已启用单人代管，可在 A / B 间切换</view>
    </view>

    <view class="card">
      <view class="section-title">纪念日设置</view>
      <input class="input" value="{{profile.anniversaryDate}}" bindinput="onAnniversaryInput" placeholder="恋爱开始日 YYYY-MM-DD"/>
      <input class="input" value="{{profile.nextMilestone}}" bindinput="onMilestoneInput" placeholder="下个纪念日 MM-DD"/>
      <view class="summary">在一起 {{loveDays}} 天 · 距离纪念日 {{countdownDays}} 天</view>
      <button class="btn" bindtap="saveDates">保存纪念日</button>
    </view>

    <view class="section-head">待打卡 <text class="badge">{{tasks.length}}</text></view>
    <view class="task-card" wx:for="{{tasks}}" wx:key="id">
      <view class="task-title">{{item.title}}</view>
      <view class="task-desc">{{item.desc}}</view>
      <view class="task-foot">
        <text>💗 +{{item.points}} 分 · 第 {{item.done + 1}}/{{item.target}} 次</text>
        <button size="mini" class="btn-mini" data-id="{{item.id}}" bindtap="finishTask" disabled="{{item.done >= item.target}}">打卡</button>
      </view>
    </view>
  </view>
</view>
