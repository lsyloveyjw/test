<view class="page" wx:if="{{space}}">
  <view class="topbar"><view class="title">成长空间</view></view>

  <view class="content">
    <view class="card">
      <view class="meta">Operator: {{user.nickname}} | 绑定码: {{space.code}}</view>
    </view>

    <view class="section-title">自定义任务 <text class="badge">{{space.tasks.length}}</text></view>
    <view class="card">
      <input class="input" placeholder="任务标题" value="{{taskTitle}}" bindinput="onTaskTitleInput" />
      <input class="input" type="number" placeholder="积分（默认1）" value="{{taskPoints}}" bindinput="onTaskPointsInput" />
      <button class="btn" bindtap="addTaskItem">+ 新增自定义任务</button>
    </view>

    <view class="section-title">待打卡 <text class="badge">{{space.tasks.length}}</text></view>
    <view class="task-card" wx:for="{{space.tasks}}" wx:key="id">
      <view class="task-title">{{item.title}}</view>
      <view class="task-desc">💗 +{{item.points}} 分 · 总 {{item.doneCount}} 次</view>
      <view class="actions">
        <button size="mini" class="btn-mini" data-id="{{item.id}}" bindtap="doCheckIn">打卡+1</button>
        <button size="mini" class="btn-mini second" data-id="{{item.id}}" bindtap="undoCheckIn">删除1次</button>
        <button size="mini" class="btn-mini second" data-id="{{item.id}}" data-title="{{item.title}}" data-points="{{item.points}}" bindtap="beginEditTask">修改</button>
        <button size="mini" class="btn-mini danger" data-id="{{item.id}}" bindtap="removeTask">删除任务</button>
      </view>
    </view>

    <view class="card" wx:if="{{editTaskId}}">
      <view class="section-title">修改任务</view>
      <input class="input" value="{{editTaskTitle}}" bindinput="onEditTaskTitleInput" />
      <input class="input" type="number" value="{{editTaskPoints}}" bindinput="onEditTaskPointsInput" />
      <button class="btn" bindtap="saveEditTask">保存修改</button>
    </view>
  </view>
</view>
